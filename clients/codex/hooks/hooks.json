{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__.+_ledger_(save|transition|record_fix|record_case|link|correct|batch|review|review_correct|whoami)$",
        "hooks": [
          {
            "type": "command",
            "command": "java -jar \"${PLUGIN_ROOT}/lib/ledger-client-hook.jar\" codex",
            "commandWindows": "cmd.exe /d /c java -jar \"%PLUGIN_ROOT%/lib/ledger-client-hook.jar\" codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
