# Template rendered by deploy/install.sh (@...@ placeholders). One unit per ledger instance.
[Unit]
Description=pg-ledger-mcp (@NAME@): ledger MCP endpoint (DBHub)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=@USER@
Group=@USER@
EnvironmentFile=@ETC@/env
# DBHub reads DBHUB_AUTH_TOKEN and DBHUB_ALLOWED_HOSTS from the environment; it listens on loopback only.
ExecStart=@NODE@ @DBHUB_JS@ --transport http --host 127.0.0.1 --port ${PGLEDGER_MCP_PORT} --config @ETC@/dbhub.toml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
