#!/usr/bin/env bash
# ledger-admin : owner operations that no MCP tool can do. Run as root on the database host.
#   ledger-admin [--name pg-ledger-mcp] project-add <ID> <CODE> <title>      CODE: ^[A-Z][A-Z0-9_]{0,31}$ (defect ids are CODE-D-0001...)
#   ledger-admin [--name ...] category-add <code> <name> <definition>       = code-set DEFECT_CATEGORY ...
#   ledger-admin [--name ...] code-set <group> <code> <name> <description> [--name-en <name>] [--description-en <text>] [--sort <n>] [--inactive]
#                                                                         add or update a common code (never deleted)
#   ledger-admin [--name ...] codes [<group>]                             common codes and the columns using them
#   ledger-admin [--name ...] grant <author-id> <project-id> <scope>... [--expires <timestamptz>] [--note <text>]
#                                                                         scope: defect | task | fix | verify
#   ledger-admin [--name ...] revoke <author-id> [<project-id> [<scope>]]
#   ledger-admin [--name ...] grants [<author-id>]                       live grants
#   ledger-admin [--name ...] serve [--port 8766] [--host 127.0.0.1]     start the admin web server
# Database and port come from /etc/<name>/env (written by deploy/install.sh). Values are passed as psql variables.
set -euo pipefail
NAME=pg-ledger-mcp
if [ "${1:-}" = --name ]; then NAME=${2:?}; shift 2; fi
ENV_FILE=/etc/$NAME/env
usage() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
[ $# -ge 1 ] || usage 2
[ -r "$ENV_FILE" ] || { echo "ledger-admin: $ENV_FILE not readable (run as root after deploy/install.sh)" >&2; exit 1; }
DB=$(sed -n 's/^PGLEDGER_DB=//p' "$ENV_FILE" | tail -n 1)
PG_PORT=$(sed -n 's/^PGLEDGER_PGPORT=//p' "$ENV_FILE" | tail -n 1)
# SQL on stdin, arguments as psql variables (:'name' quotes them safely)
pg() { runuser -u postgres -- psql -X -v ON_ERROR_STOP=1 -p "$PG_PORT" -d "$DB" "$@"; }

cmd=$1; shift
case "$cmd" in
  project-add)
    [ $# -eq 3 ] || usage 2
    pg -v id="$1" -v code="$2" -v title="$3" <<'SQL'
INSERT INTO ledger.project (id, code, title) VALUES (:'id', :'code', :'title') RETURNING *;
SQL
    ;;
  category-add|code-set)
    if [ "$cmd" = category-add ]; then set -- DEFECT_CATEGORY "$@"; fi
    [ $# -ge 4 ] || usage 2
    group=$1 code=$2 name=$3 desc=$4; shift 4
    name_en=$name desc_en=$desc sort=0 active=true
    while [ $# -gt 0 ]; do
      case "$1" in
        --name-en) name_en=${2:?}; shift 2 ;;
        --description-en) desc_en=${2:?}; shift 2 ;;
        --sort) sort=${2:?}; shift 2 ;;
        --inactive) active=false; shift ;;
        *) usage 2 ;;
      esac
    done
    pg -v grp="$group" -v code="$code" -v name="$name" -v descr="$desc" -v name_en="$name_en" -v desc_en="$desc_en" -v sort="$sort" -v active="$active" <<'SQL'
INSERT INTO ledger.common_code (code_group, code, name_ko, name_en, description_ko, description_en, sort_order, active)
VALUES (:'grp', :'code', :'name', :'name_en', :'descr', :'desc_en', :'sort'::int, :'active'::boolean)
ON CONFLICT (code_group, code) DO UPDATE SET name_ko = EXCLUDED.name_ko, name_en = EXCLUDED.name_en,
  description_ko = EXCLUDED.description_ko, description_en = EXCLUDED.description_en,
  sort_order = EXCLUDED.sort_order, active = EXCLUDED.active
RETURNING *;
SQL
    "$(dirname "$0")/../deploy/render-tools.sh" --name "$NAME"
    systemctl restart "$NAME.service"
    port=$(sed -n 's/^PGLEDGER_MCP_PORT=//p' "$ENV_FILE" | tail -n 1)
    deadline=$((SECONDS + 30))
    until curl -fsS "http://127.0.0.1:$port/healthz" >/dev/null 2>&1; do
      [ $SECONDS -lt $deadline ] || { echo "ledger-admin: $NAME healthz timeout after code update" >&2; exit 1; }
      sleep 1
    done
    ;;
  codes)
    pg -v grp="${1:-}" <<'SQL'
SELECT jsonb_pretty(coalesce(jsonb_agg(to_jsonb(c) ORDER BY code_group,sort_order,code),'[]'))
  FROM ledger.common_code c WHERE :'grp'='' OR code_group=:'grp';
SQL
    ;;
  grant)
    [ $# -ge 3 ] || usage 2
    author=$1 project=$2; shift 2
    scopes=() expires= note=
    while [ $# -gt 0 ]; do
      case "$1" in
        --expires) expires=${2:?}; shift 2 ;;
        --note) note=${2:?}; shift 2 ;;
        *) scopes+=("$1"); shift ;;
      esac
    done
    [ ${#scopes[@]} -ge 1 ] || usage 2
    for scope in "${scopes[@]}"; do
      pg -v author="$author" -v project="$project" -v scope="$scope" -v expires="$expires" -v note="$note" <<'SQL'
SELECT ledger.grant_session(:'author', :'project', :'scope', nullif(:'expires', '')::timestamptz, nullif(:'note', '')) AS grant_id;
SQL
    done
    ;;
  revoke)
    [ $# -ge 1 ] && [ $# -le 3 ] || usage 2
    pg -v author="$1" -v project="${2:-}" -v scope="${3:-}" <<'SQL'
SELECT ledger.revoke_session(:'author', nullif(:'project', ''), nullif(:'scope', '')) AS revoked;
SQL
    ;;
  grants)
    pg -v author="${1:-}" <<'SQL'
SELECT id, author_id, project, scope, granted_at, expires_at, note FROM ledger.session_grant
 WHERE revoked_at IS NULL AND (expires_at IS NULL OR expires_at > now()) AND (:'author' = '' OR author_id = :'author')
 ORDER BY author_id, project, scope;
SQL
    ;;
  serve)
    exec node "$(dirname "$0")/ledger-admin-server.mjs" --name "$NAME" "$@"
    ;;
  -h|--help) usage ;;
  *) echo "unknown command: $cmd" >&2; usage 2 ;;
esac
